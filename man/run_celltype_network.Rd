    seq_len(8L),
    seq_len(2L),
    function(donor, feature) (donor + feature)^2 / 10
)
dimnames(metabolites) <- list(donor_ids, c("M1", "M2"))
network <- run_celltype_network(
    scee,
    metabolites,
    celltype = "Monocyte",
    sample_col = "donor_id",
    method = "block_glasso",
    stability = FALSE,
    min_cells = 5L,
    top_var_genes = 3L
